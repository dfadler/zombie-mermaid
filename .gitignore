# Dependencies
node_modules/

# Build output
dist/
site/
*.tsbuildinfo

# Generated files
index.html
editor.html
fork-fixes.html
diagrams/
sitemap.xml
dashboard.html
xychart-test.html

# index.ts's bundled client script (demo/index-page-client.ts, #759),
# alongside index.html above -- mirrors diagrams/assets/ and blog/assets/,
# both already covered by their own parent directory's ignore line. Rooted
# (leading /) so this only ignores the repo-root assets/ dir index.ts
# writes, not a same-named directory elsewhere in the tree.
/assets/

# blog.ts output (blog/<slug>.html, blog/index.html, blog/feed.xml,
# blog/assets/); mv'd into site/blog by build:site. blog-posts/ (the
# Markdown sources) is a separate, non-ignored sibling directory.
blog/

# Pre-fix source trees extracted by fork-fixes.ts; rebuilt on demand.
.fork-fixes-cache/

# Scratch .cast/.gif/frame files from scripts/capture-fork-fixes-terminal.ts;
# cleaned up on a successful run, ignored in case one is interrupted.
.fork-fixes-screenshots-scratch/

# Human-reviewable before/after report from scripts/visual-diff.ts.
visual-diff.html
.visual-diff-cache/

# On-disk cache for scripts/load-css-module.ts's CSS Modules seam
# (zombie-mermaid#938) — keyed by content hash, safe to delete any time.
.css-modules-cache/

# Human-reviewable SVG-vs-ASCII report from scripts/form-diff.ts.
form-diff.html

# Per-sample real-mermaid/ASCII data dump from scripts/form-facts.ts, input
# to the scripts/form-judge.workflow.mjs judge pipeline.
.form-facts/
form-facts-index.json

# Per-category verdict cache (scripts/lib/form-judge-cache.ts) and the
# intermediate files scripts/form-judge-prepare.ts / form-judge-finalize-
# cache.ts produce from it — all local-runnable, none of it committed.
.form-judge-cache/
form-judge-data-*.json
form-judge-hashes-*.json
form-judge-results-*.jsonl
form-judge-prompt-*.md

# Transient bench.ts --json= output (CI's own run). bench-baseline.json is
# the committed, intentionally-updated baseline and is NOT ignored.
bench-current.json

# Playwright Test's own report/diff output from a visual-test failure. The
# committed baselines these compare against live in
# __tests__/visual/__screenshots__/ and are NOT ignored.
playwright-report/
test-results/
blob-report/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Test coverage
coverage/
