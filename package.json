{
  "name": "zombie-mermaid",
  "version": "5.8.2",
  "license": "MIT",
  "description": "Render Mermaid diagrams as beautiful SVGs or ASCII art. Ultra-fast, fully themeable, zero DOM dependencies. Maintained fork of beautiful-mermaid.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ascii": {
      "import": {
        "types": "./dist/ascii.d.ts",
        "default": "./dist/ascii.js"
      },
      "require": {
        "types": "./dist/ascii.d.cts",
        "default": "./dist/ascii.cjs"
      }
    },
    "./ascii-layout": {
      "import": {
        "types": "./dist/ascii-layout.d.ts",
        "default": "./dist/ascii-layout.js"
      },
      "require": {
        "types": "./dist/ascii-layout.d.cts",
        "default": "./dist/ascii-layout.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dfadler/zombie-mermaid"
  },
  "homepage": "https://github.com/dfadler/zombie-mermaid",
  "bugs": {
    "url": "https://github.com/dfadler/zombie-mermaid/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mermaid",
    "diagram",
    "svg",
    "ascii",
    "flowchart",
    "sequence-diagram",
    "class-diagram",
    "er-diagram",
    "xychart",
    "state-diagram",
    "visualization",
    "theming",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "ai-agent",
    "llm-tools"
  ],
  "author": "Dustin Fadler",
  "contributors": [
    "Craft Docs (original author)"
  ],
  "bin": {
    "zombie-mermaid": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run -c config/vitest.config.ts",
    "test:shuffle": "vitest run -c config/vitest.config.ts --sequence.shuffle.files --sequence.shuffle.tests",
    "test:watch": "vitest -c config/vitest.config.ts",
    "test:coverage": "vitest run -c config/vitest.config.ts --coverage",
    "test:visual": "playwright test",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:visual:watch": "playwright test --ui",
    "test:ascii-text:update": "vitest run -c config/vitest.config.ts __tests__/ascii-text-snapshots.test.ts -u",
    "test:visual:update": "playwright test --update-snapshots",
    "coverage:diff": "tsx scripts/check-diff-coverage.ts",
    "dev": "vite",
    "bench": "tsx scripts/bench.ts",
    "bench:compare": "tsx scripts/bench-compare.ts",
    "bench:scaling": "tsx scripts/bench-scaling.ts",
    "bench:label-placement": "tsx scripts/bench-label-placement.ts",
    "bench:core": "tsx scripts/bench-core.ts",
    "bench:mermaid-parser": "tsx scripts/bench-mermaid-parser.ts",
    "bench:svg-renderer": "tsx scripts/bench-svg-renderer.ts",
    "bench:ascii-renderer": "tsx scripts/bench-ascii-renderer.ts",
    "bench:package-compare": "tsx scripts/bench-package-compare.ts",
    "bench:history:append": "tsx scripts/bench-history-append.ts",
    "metrics:history:append": "tsx scripts/metrics-history-append.ts",
    "bench:trend": "tsx scripts/bench-trend.ts",
    "bench:mcp": "tsx scripts/bench-mcp.ts",
    "check:changesets": "tsx scripts/check-changesets.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "smoke:packed": "node scripts/smoke-test-packed.mjs",
    "check:pack-dist": "node scripts/check-pack-dist.mjs",
    "check:package-types": "scripts/check-package-types.sh",
    "check:bundle-size": "tsx scripts/check-bundle-size.ts",
    "size:report": "tsx scripts/size-report.ts",
    "generate:hero": "tsx scripts/generate-hero.ts",
    "build:mono-font": "tsx scripts/build-mono-font-subset.ts && oxfmt demo/components/generated/mono-font-subset.ts demo/styles.css packages/svg-renderer/src/generated/mono-font-subset.ts",
    "generate:primitives-classes": "tsx scripts/generate-primitives-classes.ts && oxfmt demo/components/generated/primitives-classes.ts",
    "generate:logo-lockup": "tsx scripts/generate-logo-lockup.ts",
    "api:report": "tsx scripts/api-report.ts",
    "mutation": "stryker run",
    "docs:scripts": "tsx scripts/generate-development-scripts-doc.ts && oxfmt docs/development-scripts.md",
    "badge:bundle-size": "tsx scripts/generate-bundle-badge.ts",
    "visual-diff": "tsx scripts/visual-diff.ts",
    "form-diff": "tsx scripts/form-diff.ts",
    "form-facts": "tsx scripts/form-facts.ts",
    "form-judge-prepare": "tsx scripts/form-judge-prepare.ts",
    "form-judge-finalize-cache": "tsx scripts/form-judge-finalize-cache.ts",
    "form-judge-calibrate": "tsx scripts/form-judge-calibrate.ts",
    "mention-watch": "tsx scripts/mention-watch.ts",
    "build": "pnpm run build:packages && vite build --app --config config/vite.config.lib.ts",
    "build:packages": "vite build --app --config packages/core/vite.config.ts && vite build --app --config packages/mermaid-parser/vite.config.ts && vite build --app --config packages/svg-renderer/vite.config.ts && vite build --app --config packages/ascii-renderer/vite.config.ts && vite build --app --config packages/mcp/vite.config.ts && vite build --config packages/mcp/vite.worker.config.ts",
    "build:site": "rm -rf site && vite build --app -c vite.site.config.ts",
    "lint": "oxlint --report-unused-disable-directives-severity=error .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json && tsc --noEmit -p editor/tsconfig.json",
    "dashboard:data": "tsx scripts/generate-dashboard-data.ts",
    "upstream:pr-candidates": "tsx scripts/list-upstream-pr-rescue-candidates.ts",
    "audit:responsive": "tsx scripts/audit-responsive.ts",
    "layout:oracle": "tsx scripts/layout-oracle.ts",
    "elk-layout:oracle": "tsx scripts/elk-layout-oracle.ts --gallery",
    "elk-layout:font": "tsx scripts/elk-layout-font.ts",
    "layout:scorecard": "tsx scripts/layout-oracle.ts --history=layout-fidelity-history.jsonl --scorecard=docs/layout-fidelity-scorecard.md && oxfmt docs/layout-fidelity-scorecard.md",
    "label:oracle": "tsx scripts/label-position-oracle.ts",
    "verify": "scripts/verify.sh",
    "doctor": "scripts/doctor.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@zombie-mermaid/ascii-renderer": "workspace:*",
    "@zombie-mermaid/core": "workspace:*",
    "@zombie-mermaid/mcp": "workspace:*",
    "@zombie-mermaid/mermaid-parser": "workspace:*",
    "@zombie-mermaid/svg-renderer": "workspace:*",
    "elkjs": "^0.12.0",
    "entities": "^7.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@fast-check/vitest": "0.5.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/headless": "^6.0.0",
    "@zombie-mermaid/ascii-layout": "workspace:*",
    "@zombie-mermaid/elk-layout": "workspace:*",
    "elkjs-0.9.3": "npm:elkjs@0.9.3",
    "fast-check": "4.10.2",
    "fontkit": "^2.0.4",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "marked": "^18.0.11",
    "mermaid": "12.1.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "publint": "0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^3.19.0",
    "subset-font": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependencies": {
    "elkjs-0.9.3": "0.9.3"
  },
  "peerDependenciesMeta": {
    "elkjs-0.9.3": {
      "optional": true
    }
  }
}
