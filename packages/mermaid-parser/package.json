{
  "name": "@zombie-mermaid/mermaid-parser",
  "version": "5.11.3",
  "license": "MIT",
  "description": "Parsers for flowchart, class, ER, sequence, XY chart, pie, C4, and architecture diagrams — the per-type parse functions both svg-renderer and ascii-renderer import directly (maintained continuation of beautiful-mermaid).",
  "keywords": [
    "mermaid",
    "zombie-mermaid",
    "beautiful-mermaid",
    "diagram",
    "parser",
    "flowchart",
    "sequence-diagram",
    "class-diagram",
    "er-diagram"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dfadler/zombie-mermaid",
    "directory": "packages/mermaid-parser"
  },
  "homepage": "https://github.com/dfadler/zombie-mermaid#readme",
  "bugs": {
    "url": "https://github.com/dfadler/zombie-mermaid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "dependencies": {
    "@zombie-mermaid/core": "workspace:*"
  },
  "scripts": {
    "build": "vite build --app --config vite.config.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
