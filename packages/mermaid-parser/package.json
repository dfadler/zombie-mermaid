{
  "name": "@zombie-mermaid/mermaid-parser",
  "version": "5.0.1",
  "license": "MIT",
  "description": "Parsers for flowchart, class, ER, sequence, XY chart, pie, C4, and architecture diagrams \u2014 the per-type parse functions both svg-renderer and ascii-renderer import directly.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfadler/zombie-mermaid",
    "directory": "packages/mermaid-parser"
  },
  "homepage": "https://github.com/dfadler/zombie-mermaid#readme",
  "bugs": {
    "url": "https://github.com/dfadler/zombie-mermaid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "LICENSE"
  ],
  "dependencies": {
    "@zombie-mermaid/core": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
