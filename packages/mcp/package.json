{
  "name": "@zombie-mermaid/mcp",
  "version": "5.12.0",
  "license": "MIT",
  "description": "Model Context Protocol server exposing zombie-mermaid's SVG and ASCII rendering as MCP tools (maintained continuation of beautiful-mermaid).",
  "keywords": [
    "mermaid",
    "zombie-mermaid",
    "beautiful-mermaid",
    "diagram",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "ai-agent",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dfadler/zombie-mermaid",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/dfadler/zombie-mermaid#readme",
  "bugs": {
    "url": "https://github.com/dfadler/zombie-mermaid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "dependencies": {
    "@zombie-mermaid/core": "workspace:*",
    "@zombie-mermaid/mermaid-parser": "workspace:*",
    "@zombie-mermaid/svg-renderer": "workspace:*",
    "@zombie-mermaid/ascii-renderer": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.5.4",
    "elkjs": "^0.12.0"
  },
  "scripts": {
    "build": "vite build --app --config vite.config.ts && vite build --config vite.worker.config.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
