{
  "name": "@zombie-mermaid/mcp",
  "version": "2.2.0",
  "license": "MIT",
  "description": "Model Context Protocol server exposing zombie-mermaid's SVG and ASCII rendering as MCP tools.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src/",
    "dist/",
    "LICENSE"
  ],
  "dependencies": {
    "@zombie-mermaid/core": "workspace:*",
    "@zombie-mermaid/mermaid-parser": "workspace:*",
    "@zombie-mermaid/svg-renderer": "workspace:*",
    "@zombie-mermaid/ascii-renderer": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "entities": "^7.0.1",
    "zod": "^4.5.4"
  }
}
