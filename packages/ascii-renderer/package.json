{
  "name": "@zombie-mermaid/ascii-renderer",
  "version": "2.2.0",
  "license": "MIT",
  "description": "ASCII and Unicode box-drawing renderer for zombie-mermaid diagrams.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src/",
    "dist/",
    "LICENSE"
  ],
  "dependencies": {
    "@zombie-mermaid/core": "workspace:*",
    "@zombie-mermaid/mermaid-parser": "workspace:*"
  }
}
