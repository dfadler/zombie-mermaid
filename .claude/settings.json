{
  "worktree": {
    "autoPrune": true
  },
  "permissions": {
    "deny": [
      "Bash(gh pr create --repo lukilabs/beautiful-mermaid*)",
      "Bash(gh pr create --repo=lukilabs/beautiful-mermaid*)",
      "Bash(git push upstream*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/remote-guard.sh",
            "statusMessage": "Remote guard (denies upstream, warns on non-owned remotes)...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/research-nudge.sh",
            "timeout": 10,
            "statusMessage": "Research-doc nudge (warn-only)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/pre-pr-check.sh --hook",
            "timeout": 10,
            "statusMessage": "Pre-PR check (warn-only)..."
          }
        ]
      }
    ]
  }
}
