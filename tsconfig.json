{
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "zombie-mermaid": ["./src/index.ts"],
      "zombie-mermaid/*": ["./src/*"]
    },
    // ".", not "src": the workspace packages under packages/*/src are part
    // of the same program (see "include" below), and rootDir has to contain
    // every input file. Under noEmit this only affects rootDir's own
    // consistency check — the same reasoning demo/tsconfig.json records for
    // its own widening.
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "packages/*/src/**/*"],
  "exclude": ["node_modules", "dist", "**/node_modules"]
}
